# ============================================================================
# Obelisk — environment variables. Copy to .env and fill in. NEVER commit .env.
# Shared dev/staging secrets live in Doppler; this file is the local source.
# ============================================================================

# --- LLM (backend) ---------------------------------------------------------
# Required for any agent call. The backend fails loudly if missing.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-sonnet-4-6).
# OBELISK_MODEL=claude-sonnet-4-6

# --- Database (backend) ----------------------------------------------------
# Matches infra/docker-compose.dev.yml. pgvector-enabled Postgres 16.
DATABASE_URL=postgresql+psycopg://obelisk:obelisk@localhost:5432/obelisk

# --- Auth: Clerk -----------------------------------------------------------
# Backend verifies Clerk JWTs. Get these from the Clerk dashboard.
CLERK_SECRET_KEY=sk_test_...
# JWKS endpoint OR issuer for JWT verification (issuer is preferred).
CLERK_ISSUER=https://apparent-wahoo-59.clerk.accounts.dev/.well-known/jwks.json
# Optional: restrict accepted audience.
# CLERK_AUDIENCE=

# --- Object storage (S3 / Cloudflare R2) -----------------------------------
# Phase 1 stubs artifacts; these are wired but optional locally.
OBELISK_S3_BUCKET=obelisk-artifacts
OBELISK_S3_REGION=auto
# For R2: https://<account>.r2.cloudflarestorage.com
OBELISK_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Error tracking --------------------------------------------------------
# Optional in Phase 1. Leave blank to disable Sentry.
SENTRY_DSN=

# --- Advisor Brief ---------------------------------------------------------
# Optional override for the grounding doc. Defaults to docs/advisor_brief.md.
# OBELISK_BRIEF_PATH=

# ============================================================================
# Frontend (apps/desktop) — Vite exposes only VITE_*-prefixed vars to the app.
# ============================================================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YXBwYXJlbnQtd2Fob28tNTkuY2xlcmsuYWNjb3VudHMuZGV2JA
VITE_API_BASE_URL=http://localhost:8000

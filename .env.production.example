# ============================================================================
# Obelisk — PRODUCTION / closed-beta environment template.
# Copy into your secret store (Doppler / runtime injection); NEVER commit a
# filled-in copy. Values that are already correct for the beta are pre-set;
# blanks need a real credential (see docs/phase2_beta_handoff.md §1 for where).
#
# Flag-flips that MUST be exactly these for prod are marked  <<< FLAG.
# ============================================================================

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=                       # console.anthropic.com -> API Keys
# OBELISK_MODEL=claude-sonnet-4-6        # optional override (default shown)
# MAX_COST_USD=1.50                      # optional per-session USD ceiling

# --- Database --------------------------------------------------------------
# Postgres with pgvector. Form: postgresql+psycopg://USER:PASS@HOST:5432/DB
# (the +psycopg suffix matters — the app uses psycopg3, not psycopg2.)
# Railway (pgvector/pgvector:pg16 service): reference the DB service's private domain, e.g.
#   postgresql+psycopg://obelisk:<PASS>@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/obelisk
DATABASE_URL=

# --- Auth: Clerk -----------------------------------------------------------
CLERK_ISSUER=                            # Clerk dashboard -> JWT issuer (base URL or JWKS URL)
CLERK_SECRET_KEY=                        # Clerk dashboard -> API Keys (sk_live_...)
# CLERK_AUDIENCE=                        # optional; leave unset to skip aud check
DEV_AUTH_TOKEN=                          # <<< FLAG: MUST be empty in prod (disables dev-auth bypass)
# DEV_AUTH_SUB=dev_user                  # irrelevant once the bypass is off

# --- Object storage (S3 / Cloudflare R2) -----------------------------------
OBELISK_S3_BUCKET=obelisk-artifacts
OBELISK_S3_REGION=auto                   # R2 uses "auto"; AWS uses e.g. us-east-1
OBELISK_S3_ENDPOINT=                     # R2: https://<account>.r2.cloudflarestorage.com ; omit for native S3
AWS_ACCESS_KEY_ID=                       # storage access key (read by boto, not config.py)
AWS_SECRET_ACCESS_KEY=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=                              # Sentry -> Project Settings -> Client Keys (DSN); blank disables
ENVIRONMENT=production                   # <<< FLAG: disables dev-auth bypass; tags Sentry

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true                  # keep on for prod

# --- Subscriptions: Stripe (desktop billing) -------------------------------
STRIPE_SECRET_KEY=                       # Stripe -> Developers -> API keys (sk_live_...)
STRIPE_WEBHOOK_SECRET=                   # Stripe -> Webhooks -> endpoint /v1/webhooks/stripe (whsec_...)
STRIPE_PRICE_MONTHLY=                    # Stripe -> Products -> Obelisk Plus monthly (price_...)
STRIPE_PRICE_ANNUAL=                     # Stripe -> Products -> Obelisk Plus annual (price_...)
STRIPE_SUCCESS_URL=https://app.obelisk.fit/settings?checkout=success
STRIPE_CANCEL_URL=https://app.obelisk.fit/settings?checkout=cancel

# --- Subscriptions: Apple --------------------------------------------------
APPLE_BUNDLE_ID=fit.obelisk.ios          # must match project.yml + App Store Connect + APNS_TOPIC
APPLE_STOREKIT_VERIFICATION=false        # <<< FLAG: MUST stay false until the x5c verifier is wired (true -> 501)

# --- Push: APNs ------------------------------------------------------------
APNS_KEY_ID=                             # Apple Developer -> Keys -> APNs key (Key ID)
APNS_TEAM_ID=                            # Apple Developer portal (top-right Team ID)
# APNS .p8 PEM contents. Multiline: set via your secret store, or inline with \n escapes.
APNS_PRIVATE_KEY=
APNS_TOPIC=fit.obelisk.ios               # = the app bundle id
APNS_USE_SANDBOX=true                    # <<< FLAG: true for TestFlight/beta; false only for App Store prod
PUSH_SCHEDULER_ENABLED=false             # <<< FLAG: MUST stay false until ADR-014 prerequisites are done

# --- Product analytics: PostHog --------------------------------------------
POSTHOG_API_KEY=                         # PostHog -> Project Settings (phc_...)
POSTHOG_HOST=https://us.i.posthog.com    # or EU / self-host

# --- CORS ------------------------------------------------------------------
# Comma/JSON list. Defaults cover the desktop dev-server + Tauri origins; add the
# production desktop/web origin(s) if any. Leave unset to use config.py defaults.
# CORS_ORIGINS=["https://app.obelisk.fit","tauri://localhost"]
